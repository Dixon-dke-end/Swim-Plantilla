---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../shared/styles/global.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import frauncesFont from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import AnnouncementBar from '../shared/ui/AnnouncementBar.astro';
import SiteHeader from '../shared/ui/SiteHeader.astro';
import MobileMenu from '../shared/ui/MobileMenu.astro';
import SiteFooter from '../shared/ui/SiteFooter.astro';
import CartDrawer from '../modules/cart/ui/CartDrawer.astro';
import { photos } from '../shared/assets/photos';

interface Props {
  title: string;
  description?: string;
  /** Pages that open with a full-bleed photo: the header starts transparent over it. */
  hero?: boolean;
  /** Social preview image. */
  image?: ImageMetadata;
  noindex?: boolean;
}

const BRAND = 'MAREA';
const {
  title,
  description = 'Trajes de baño de telas recicladas, probados en cloro, sol y sal. Hecho para el agua. Diseñado para quedarse.',
  hero = false,
  image = photos.onepieceStripeWaves.src,
  noindex = false,
} = Astro.props;

const fullTitle = title === BRAND ? title : `${title} | ${BRAND}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', quality: 70 });
const previewUrl = new URL(preview.src, Astro.site).toString();
---

<!doctype html>
<html lang="es" data-hero={hero ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3ede4" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={previewUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <AnnouncementBar />
    <SiteHeader />
    <MobileMenu />
    <CartDrawer />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <div class="scroll-sentinel" data-scroll-sentinel aria-hidden="true"></div>
    <script>
      import './boot';
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
