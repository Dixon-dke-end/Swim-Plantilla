---
import Photo from '../../../shared/ui/Photo.astro';
import { formatCOP } from '../../../shared/lib/format';
import type { Product } from '../data/types';

interface Props {
  product: Product;
  /** Load the photos right away (first row above the fold). */
  eager?: boolean;
  sizes?: string;
}

const {
  product,
  eager = false,
  sizes = '(min-width: 64rem) 23vw, (min-width: 48rem) 31vw, 48vw',
} = Astro.props;

const primary = product.colors[0]!;
const alternate = product.colors[1];
const href = `/producto/${product.slug}`;
const widths = [360, 540, 720, 960];
---

<article class="pcard">
  <!-- The shared photo name is set on click only, see card-morph.ts. -->
  <div class="pcard__media vt-media" data-card-media>
    <Photo
      class="pcard__img"
      src={primary.image}
      alt={primary.alt}
      position={primary.position}
      sizes={sizes}
      widths={widths}
      priority={eager}
    />
    {
      alternate && (
        <Photo
          class="pcard__img pcard__img--alt"
          src={alternate.image}
          alt=""
          position={alternate.position}
          sizes={sizes}
          widths={widths}
        />
      )
    }
    {product.isNew && <span class="badge pcard__badge">Nuevo</span>}
  </div>

  <div class="pcard__info">
    <h3 class="pcard__name" data-card-title>
      <a class="pcard__link" href={href}>{product.name}</a>
    </h3>
    <p class="pcard__price">{formatCOP(product.price)}</p>
    <ul class="pcard__dots" aria-label={`Colores: ${product.colors.map((color) => color.name).join(', ')}`}>
      {
        product.colors.map((color) => (
          <li class="pcard__dot" style={`--dot:${color.hex}`} title={color.name}></li>
        ))
      }
    </ul>
  </div>
</article>

<style is:global>
  .pcard {
    position: relative;
    display: grid;
    gap: 0.9rem;
  }

  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--sand-deep);
  }

  .pcard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1.4s var(--ease-out-expo),
      opacity 0.8s var(--ease-out-expo);
  }

  .pcard__img--alt {
    opacity: 0;
  }

  @media (hover: hover) {
    .pcard:hover .pcard__img,
    .pcard:focus-within .pcard__img {
      transform: scale(1.05);
    }

    .pcard:hover .pcard__img--alt,
    .pcard:focus-within .pcard__img--alt {
      opacity: 1;
    }
  }

  .pcard__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }

  .pcard__info {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.15rem 1rem;
  }

  .pcard__name {
    font-size: var(--text-lg);
    line-height: 1.15;
  }

  /* The whole card is one big link target. */
  .pcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .pcard__link {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.7s var(--ease-out-expo);
  }

  .pcard:hover .pcard__link,
  .pcard__link:focus-visible {
    background-size: 100% 1px;
  }

  .pcard__link:focus-visible {
    outline: none;
  }

  .pcard:has(.pcard__link:focus-visible) .pcard__media {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
  }

  .pcard__price {
    font-size: var(--text-sm);
    font-weight: 700;
    text-align: right;
  }

  .pcard__dots {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }

  .pcard__dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: inset 0 0 0 1px rgb(19 32 31 / 0.25);
  }
</style>
