---
import Icon from '../../../shared/ui/Icon.astro';

const samples = [
  {
    id: 'ventas',
    demo: 'sample-ventas',
    title: 'Plantilla MAREA',
    text: 'Libro de ventas con facturas, canales y estados de pago. Incluye filas con errores a propósito.',
    meta: 'Encabezados en la fila 1',
    icon: '<path d="M5 4h9l5 5v11H5z"/><path d="M14 4v5h5M8.5 13h7M8.5 16.5h7"/>',
  },
  {
    id: 'pos',
    demo: 'sample-pos',
    title: 'Cuadre de caja (POS)',
    text: 'Exportación del punto de venta: títulos arriba, otros nombres de columna y una fila de totales.',
    meta: 'Encabezados en la fila 4',
    icon: '<rect x="4" y="3.500" width="16" height="17" rx="2"/><path d="M8 8h8M8 12h2M12 12h2M16 12h0M8 16h2M12 16h4"/>',
  },
  {
    id: 'banco',
    demo: 'sample-banco',
    title: 'Extracto bancario',
    text: 'CSV con punto y coma y cifras como 1.234.567,00. Solo los créditos cuentan como ingresos.',
    meta: 'Débitos ignorados',
    icon: '<path d="M3.500 9.500 12 4l8.500 5.500M5.500 10v8M10 10v8M14 10v8M18.500 10v8M3.500 20h17"/>',
  },
];

const points = [
  { title: 'Cualquier formato', text: 'Reconocemos las columnas por su nombre, en español o en inglés, aunque los encabezados no estén en la primera fila.' },
  { title: 'Tu método contable', text: 'Causación o caja: el mismo archivo se recalcula al instante, con sus asientos del PUC.' },
  { title: 'Datos revisados', text: 'Fechas imposibles, duplicados, facturas anuladas y filas de totales quedan señalados, no escondidos.' },
];
---

<section class="acct-step" data-step="upload" aria-labelledby="acct-title">
  <div class="acct-hero">
    <p class="eyebrow eyebrow--coral">Contabilidad de ingresos</p>
    <h1 id="acct-title" tabindex="-1">Tus ingresos, <em>en orden.</em> Desde el Excel que ya usas.</h1>
    <p class="lead">
      Sube tu libro de ventas, el cuadre de caja del punto de venta o el extracto del banco. Reconocemos las columnas,
      calculamos el IVA y armamos tu contabilidad.
    </p>
  </div>

  <div class="acct-upload__grid">
    <label class="acct-drop" data-dropzone data-demo="dropzone">
      <input
        class="sr-only"
        type="file"
        accept=".xlsx,.xls,.csv,text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        data-file-input
        data-demo="file-input"
      />
      <span class="acct-drop__waves" aria-hidden="true">
        <svg viewBox="0 0 1200 160" preserveAspectRatio="none">
          <path d="M0 80c75 0 75-40 150-40s75 40 150 40 75-40 150-40 75 40 150 40 75-40 150-40 75 40 150 40 75-40 150-40 75 40 150 40"/>
          <path d="M0 115c75 0 75-40 150-40s75 40 150 40 75-40 150-40 75 40 150 40 75-40 150-40 75 40 150 40 75-40 150-40 75 40 150 40"/>
        </svg>
      </span>
      <span class="acct-drop__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.500 8.500M12 4l4.500 4.500M4.500 15v3.500a1.500 1.500 0 0 0 1.500 1.500h12a1.500 1.500 0 0 0 1.500-1.500V15"/></svg>
      </span>
      <span class="acct-drop__title">Arrastra tu archivo aquí</span>
      <span class="acct-drop__sub">o <span class="link link--static">elige uno desde tu computador</span></span>
      <span class="acct-drop__formats" aria-label="Formatos admitidos"><b>.xlsx</b><b>.xls</b><b>.csv</b></span>
      <span class="acct-drop__privacy">Se procesa en tu navegador. Tus datos no se suben a ningún servidor.</span>
      <span class="acct-drop__busy" data-drop-busy hidden>
        <span class="acct-spinner" aria-hidden="true"></span>
        <span data-drop-busy-text>Leyendo archivo…</span>
      </span>
    </label>

    <div class="acct-samples">
      <h2 class="acct-label">Probar con un ejemplo</h2>
      <ul>
        {
          samples.map((sample) => (
            <li>
              <button type="button" class="acct-sample" data-sample={sample.id} data-demo={sample.demo}>
                <span class="acct-sample__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={sample.icon} />
                </span>
                <span class="acct-sample__body">
                  <span class="acct-sample__title">{sample.title}</span>
                  <span class="acct-sample__text">{sample.text}</span>
                  <span class="acct-sample__meta">{sample.meta}</span>
                </span>
                <Icon name="arrow-right" class="acct-sample__go" />
              </button>
            </li>
          ))
        }
      </ul>
      <a class="link arrow-link acct-template" href="/plantillas/plantilla-ingresos-marea.xlsx" download data-demo="template-download">
        Descargar plantilla <Icon name="arrow-right" />
      </a>
    </div>
  </div>

  <p class="acct-error" role="alert" data-upload-error hidden></p>

  <div class="acct-points">
    {
      points.map((point) => (
        <div class="acct-point">
          <h3>{point.title}</h3>
          <p>{point.text}</p>
        </div>
      ))
    }
  </div>
</section>
