---
import Photo from '../../../shared/ui/Photo.astro';
import { photos } from '../../../shared/assets/photos';

const photo = photos.hibiscusFabric;
const sizes = '(min-width: 64rem) 60vw, 100vw';
const widths = [640, 960, 1440];
---

<figure class="compare" data-compare aria-labelledby="compare-title">
  <div class="compare__stage">
    <div class="compare__layer compare__layer--after">
      <Photo
        class="compare__img compare__img--faded"
        src={photo.src}
        alt="Tela convencional con el estampado descolorido después de la prueba de cloro (ilustración)"
        position={photo.position}
        sizes={sizes}
        widths={widths}
      />
    </div>
    <div class="compare__layer compare__layer--before">
      <Photo
        class="compare__img"
        src={photo.src}
        alt="Tela MAREA con el estampado intacto después de la prueba de cloro (ilustración)"
        position={photo.position}
        sizes={sizes}
        widths={widths}
      />
    </div>

    <span class="compare__tag compare__tag--before" aria-hidden="true">Tela MAREA</span>
    <span class="compare__tag compare__tag--after" aria-hidden="true">Tela convencional</span>
    <span class="compare__illustration">Ilustración</span>

    <span class="compare__handle" aria-hidden="true">
      <span class="compare__knob">
        <svg viewBox="0 0 24 24" class="icon"><path d="m9 7-5 5 5 5M15 7l5 5-5 5"></path></svg>
      </span>
    </span>

    <label class="sr-only" for="compare-range">
      Deslizar para comparar la tela MAREA con una tela convencional después de 200 horas en cloro
    </label>
    <input
      class="compare__range"
      id="compare-range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      data-compare-range
    />
  </div>
  <figcaption class="compare__caption" id="compare-title">
    Ilustración: simulación visual del desgaste tras 200 horas en cloro. No son fotografías de las pruebas.
  </figcaption>
</figure>

<style is:global>
  .compare {
    display: grid;
    gap: var(--space-sm);
    --pos: 50%;
  }

  .compare__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--sand-deep);
    touch-action: pan-y;
    user-select: none;
  }

  .compare__layer {
    position: absolute;
    inset: 0;
  }

  .compare__layer--before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .compare__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .compare__img--faded {
    filter: saturate(0.4) contrast(0.82) brightness(1.14) sepia(0.28) hue-rotate(-8deg);
  }

  .compare__tag {
    position: absolute;
    top: 1rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgb(19 32 31 / 0.78);
    color: var(--sand);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .compare__tag--before {
    left: 1rem;
  }

  .compare__tag--after {
    right: 1rem;
  }

  .compare__illustration {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--sand);
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .compare__handle {
    position: absolute;
    inset: 0 auto 0 var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--sand);
    box-shadow: 0 0 0 1px rgb(19 32 31 / 0.15);
    pointer-events: none;
  }

  .compare__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--sand);
    color: var(--ink);
    box-shadow: 0 8px 24px rgb(19 32 31 / 0.3);
    transform: translate(-50%, -50%);
    transition: transform 0.5s var(--ease-spring);
  }

  .compare:has(.compare__range:active) .compare__knob {
    transform: translate(-50%, -50%) scale(1.12);
  }

  .compare:has(.compare__range:focus-visible) .compare__knob {
    outline: 3px solid var(--teal);
    outline-offset: 3px;
  }

  /* The native range covers the stage: it handles pointer drag, touch and keyboard. */
  .compare__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
  }

  .compare__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 3.25rem;
    height: 3.25rem;
  }

  .compare__range::-moz-range-thumb {
    width: 3.25rem;
    height: 3.25rem;
    border: 0;
    background: transparent;
  }

  .compare__caption {
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
