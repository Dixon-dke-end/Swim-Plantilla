---
import Photo from '../../../shared/ui/Photo.astro';
import Icon from '../../../shared/ui/Icon.astro';
import { photos } from '../../../shared/assets/photos';

const photo = photos.onepieceStripeWaves;
const lines = [['Hecho', 'para', 'el', 'agua.'], ['Diseñado', 'para', 'quedarse.']];

// One running index so the words rise one after another across both lines.
let counter = 0;
const rows = lines.map((words) => words.map((word) => ({ word, index: counter++ })));
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__media">
    <div class="hero__parallax">
      <Photo
        class="hero__img"
        src={photo.src}
        alt={photo.alt}
        position={photo.position}
        sizes="100vw"
        widths={[640, 960, 1440, 1800]}
        quality={70}
        priority
      />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content container">
    <p class="eyebrow hero__eyebrow">Colección Verano 2026</p>
    <h1 id="hero-title" class="display display--xl hero__title">
      {
        rows.map((row) => (
          <span class="hero__line">
            {row.map(({ word, index }) => (
              <>
                <span class="hero__word">
                  <span class="hero__word-inner" style={`--i:${index}`}>
                    {word}
                  </span>
                </span>{" "}
              </>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="hero__lead">
      Trajes de baño de telas recicladas, probados en cloro, sol y sal para que duren muchas temporadas.
    </p>
    <div class="hero__cta">
      <a class="btn btn--light" href="/coleccion">
        Comprar colección <Icon name="arrow-right" />
      </a>
      <a class="btn btn--outline-light" href="/pruebas">Ver las pruebas</a>
    </div>
  </div>

  <a class="hero__scroll" href="#categorias" aria-label="Seguir bajando">
    <span class="hero__scroll-line" aria-hidden="true"></span>
    <span>Descubrir</span>
  </a>
</section>

<style is:global>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: calc(100vh - var(--bar-h));
    min-height: calc(100svh - var(--bar-h));
    padding-block: calc(var(--header-h) + var(--space-xl)) clamp(4.5rem, 3rem + 5vw, 7rem);
    overflow: hidden;
    background: var(--teal-deep);
    color: var(--sand);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__parallax {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-kenburns 16s var(--ease-out-quart) both;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(9 53 55 / 0.55) 0%, rgb(9 53 55 / 0) 28%),
      linear-gradient(0deg, rgb(9 30 31 / 0.78) 0%, rgb(9 30 31 / 0.25) 45%, rgb(9 30 31 / 0) 70%);
  }

  .hero__content {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .hero__eyebrow {
    color: var(--sand);
    opacity: 0.92;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.45);
    animation: rise-in 1s var(--ease-out-expo) 0.1s both;
  }

  .hero__title {
    color: var(--sand);
    text-wrap: balance;
  }

  .hero__line {
    display: block;
  }

  .hero__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .hero__word-inner {
    display: inline-block;
    animation: hero-word-rise 1.2s var(--ease-out-expo) both;
    animation-delay: calc(var(--i, 0) * 85ms + 220ms);
  }

  .hero__lead {
    max-width: 44ch;
    font-size: var(--text-lg);
    color: rgb(243 237 228 / 0.92);
    animation: rise-in 1.1s var(--ease-out-expo) 0.9s both;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    animation: rise-in 1.1s var(--ease-out-expo) 1.05s both;
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    display: none;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: rise-in 1.1s var(--ease-out-expo) 1.4s both;
  }

  .hero__scroll-line {
    position: relative;
    width: 3.5rem;
    height: 1px;
    background: rgb(243 237 228 / 0.4);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--sand);
    animation: hero-scroll-line 2.4s var(--ease-in-out) infinite;
  }

  @media (min-width: 48rem) {
    .hero__scroll {
      display: inline-flex;
    }
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1.16);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes hero-word-rise {
    from {
      transform: translateY(112%) rotate(3deg);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-scroll-line {
    0% {
      transform: translateX(-100%);
    }
    55%,
    100% {
      transform: translateX(100%);
    }
  }

  /* Parallax and fade-out while the hero scrolls away (scroll-driven, no listeners). */
  @keyframes hero-parallax {
    to {
      transform: translateY(14%);
    }
  }

  @keyframes hero-content-out {
    to {
      opacity: 0;
      transform: translateY(-48px);
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__parallax {
        inset: -14% 0 0;
        animation-name: hero-parallax;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

      .hero__content {
        animation-name: hero-content-out;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 70vh;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img,
    .hero__word-inner,
    .hero__eyebrow,
    .hero__lead,
    .hero__cta,
    .hero__scroll,
    .hero__scroll-line::after {
      animation: none !important;
    }
  }
</style>
