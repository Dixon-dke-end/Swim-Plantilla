---
interface Props {
  items: string[];
  label?: string;
}

const { items, label = 'Beneficios de la marca' } = Astro.props;
---

<div class="marquee" role="group" aria-label={label}>
  <div class="marquee__track">
    <ul class="marquee__group">
      {
        items.map((item) => (
          <li class="marquee__item">
            <span>{item}</span>
            <span class="marquee__dot" aria-hidden="true"></span>
          </li>
        ))
      }
    </ul>
    <ul class="marquee__group" aria-hidden="true">
      {
        items.map((item) => (
          <li class="marquee__item">
            <span>{item}</span>
            <span class="marquee__dot" aria-hidden="true"></span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .marquee {
    padding-block: 1.1rem;
    background: var(--teal);
    color: var(--sand);
    border-block: 1px solid var(--teal-deep);
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-inline: clamp(0.75rem, 2vw, 1.75rem);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 0.9rem + 1.2vw, 1.9rem);
    font-weight: 360;
    font-style: italic;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .marquee__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--coral);
    flex: none;
  }
</style>
