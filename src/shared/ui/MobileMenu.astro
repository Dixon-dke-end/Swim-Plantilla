---
import Icon from './Icon.astro';
import { NAV_LINKS } from '../lib/nav';
---

<div
  id="mobile-menu"
  class="menu on-dark"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
  hidden
  inert
  transition:persist="mobile-menu"
>
  <div class="menu__bar container">
    <a class="wordmark" href="/" aria-label="MAREA, ir al inicio">MAREA</a>
    <button type="button" class="icon-btn" data-menu-close aria-label="Cerrar menú">
      <Icon name="close" />
    </button>
  </div>

  <nav class="menu__nav container" aria-label="Menú móvil">
    <ul class="menu__list">
      {
        NAV_LINKS.map((link, index) => (
          <li class="menu__item" style={`--i:${index}`}>
            <a class="menu__link" href={link.href} data-nav-link>
              <span class="menu__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="menu__foot container">
    <p class="menu__note">Hecho para el agua. Diseñado para quedarse.</p>
    <a class="link" href="mailto:hola@marea.example">hola@marea.example</a>
  </div>
</div>

<style is:global>
  .menu {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    background: var(--teal-deep);
    color: var(--sand);
    overflow-y: auto;
    overscroll-behavior: contain;
    view-transition-name: mobile-menu;
    view-transition-class: vt-menu;
  }

  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    flex: none;
  }

  .menu__bar .icon-btn:hover {
    background: rgb(243 237 228 / 0.12);
  }

  .menu__nav {
    flex: 1;
    display: grid;
    align-content: center;
    padding-block: var(--space-lg);
  }

  .menu__list {
    display: grid;
    gap: 0.25rem;
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.4rem + 6vw, 4.2rem);
    font-weight: 340;
    letter-spacing: -0.03em;
    line-height: 1.05;
    transition:
      transform 0.6s var(--ease-out-expo),
      color 0.4s var(--ease-out-expo);
  }

  .menu__link:hover,
  .menu__link:focus-visible {
    transform: translateX(0.6rem);
    color: var(--coral);
  }

  .menu__link[aria-current='page'] {
    font-style: italic;
  }

  .menu__index {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgb(243 237 228 / 0.7);
  }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: var(--space-lg);
    border-top: 1px solid rgb(243 237 228 / 0.2);
    font-size: var(--text-sm);
    flex: none;
  }

  .menu.is-open .menu__item,
  .menu.is-open .menu__foot {
    animation: rise-in 0.9s var(--ease-out-expo) both;
    animation-delay: calc(var(--i, 5) * 70ms + 220ms);
  }

  @media (min-width: 72rem) {
    .menu {
      display: none;
    }
  }
</style>
