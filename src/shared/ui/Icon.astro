---
type IconName =
  | 'bag'
  | 'search'
  | 'menu'
  | 'close'
  | 'arrow-right'
  | 'arrow-left'
  | 'arrow-up-right'
  | 'check'
  | 'plus'
  | 'minus'
  | 'chevron-down'
  | 'ruler'
  | 'drop'
  | 'sun'
  | 'wave'
  | 'stretch'
  | 'wind'
  | 'leaf'
