---
import Icon from './Icon.astro';
import { NAV_LINKS } from '../lib/nav';
---

<header class="site-header" transition:persist="site-header">
  <div class="site-header__bg" aria-hidden="true"></div>
  <div class="site-header__inner container">
    <div class="site-header__start">
      <button
        type="button"
        class="icon-btn site-header__burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
        data-menu-open
      >
        <Icon name="menu" />
      </button>
      <nav class="site-header__nav" aria-label="Principal">
        <ul>
          {
            NAV_LINKS.map((link) => (
              <li>
                <a class="nav-link" href={link.href} data-nav-link>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <a class="wordmark" href="/" aria-label="MAREA, ir al inicio">MAREA</a>

    <div class="site-header__actions">
      <span class="icon-btn site-header__search" aria-hidden="true">
        <Icon name="search" />
      </span>
      <button
        type="button"
        class="icon-btn bag-btn"
        aria-label="Abrir bolsa, vacía"
        aria-expanded="false"
        aria-controls="cart-drawer"
        data-cart-open
      >
        <Icon name="bag" />
        <span class="bag-btn__count" data-cart-count aria-hidden="true">0</span>
      </button>
    </div>
  </div>
</header>

<style is:global>
  /*
   * Header: fixed, docks under the announcement bar as the page scrolls.
   * Scroll-driven where supported; otherwise html.is-scrolled drives CSS transitions.
   */
  .site-header {
    --hdr-fg-start: var(--ink);
    --hdr-bg-start: 1;

    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    transform: translateY(var(--bar-h));
    color: var(--hdr-fg-start);
    transition:
      transform 0.5s var(--ease-out-expo),
      height 0.5s var(--ease-out-expo);
  }

  html[data-hero='true'] .site-header {
    --hdr-fg-start: var(--sand);
    --hdr-bg-start: 0;
  }

  .site-header__bg {
    position: absolute;
    inset: 0;
    background: rgb(243 237 228 / 0.94);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 1px 0 var(--stone);
    opacity: var(--hdr-bg-start);
    view-transition-name: site-header-bg;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .site-header__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    color: inherit;
    view-transition-name: site-header;
    transition: color 0.4s var(--ease-out-expo);
  }

  html.is-scrolled .site-header {
    transform: translateY(0);
    height: var(--header-h-compact);
  }

  html.is-scrolled .site-header__bg {
    opacity: 1;
  }

  html.is-scrolled .site-header__inner {
    color: var(--ink);
  }

  @keyframes header-dock {
    from {
      transform: translateY(var(--bar-h));
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes header-shrink {
    to {
      height: var(--header-h-compact);
    }
  }

  @keyframes header-bg {
    from {
      opacity: var(--hdr-bg-start);
    }
    to {
      opacity: 1;
    }
  }

  @keyframes header-fg {
    from {
      color: var(--hdr-fg-start);
    }
    to {
      color: var(--ink);
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header {
        transition: none;
        animation-name: header-dock, header-shrink;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root), scroll(root);
        animation-range:
          0px var(--bar-h),
          0px 10rem;
      }

      .site-header__bg {
        transition: none;
        animation-name: header-bg;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0px 10rem;
      }

      .site-header__inner {
        transition: none;
        animation-name: header-fg;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0px 10rem;
      }
    }
  }

  .site-header__start,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__actions {
    justify-content: flex-end;
    gap: 0.15rem;
  }

  .site-header__burger {
    display: none;
    margin-left: -0.6rem;
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(1.1rem, 2vw, 2.25rem);
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: auto 0 0.2rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.85rem);
    font-weight: 500;
    letter-spacing: 0.34em;
    padding-left: 0.34em;
    line-height: 1;
  }

  .site-header .icon-btn:hover {
    background: rgb(128 128 128 / 0.18);
  }

  .site-header .bag-btn {
    position: relative;
  }

  @media (max-width: 71.99rem) {
    .site-header__nav {
      display: none;
    }

    .site-header__burger {
      display: inline-grid;
    }

    .site-header__search {
      display: none;
    }
  }

  .scroll-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 3rem;
    pointer-events: none;
  }
</style>
