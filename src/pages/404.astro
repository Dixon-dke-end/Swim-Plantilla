---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../shared/ui/Icon.astro';

const digits = ['4', '0', '4'];

// One period is 300 units wide, so translating by half the 1200-unit path loops seamlessly.
const crest = 'c75 0 75-40 150-40s75 40 150 40';
const waveBack = `M0 80${crest.repeat(4)}V160H0Z`;
const waveFront = `M0 96${crest.repeat(4)}V160H0Z`;
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o cambió de lugar." noindex>
  <section class="lost" aria-labelledby="lost-title">
    <div class="lost__waves" aria-hidden="true">
      <svg class="lost__wave lost__wave--back" viewBox="0 0 1200 160" preserveAspectRatio="none">
        <path d={waveBack}></path>
      </svg>
      <svg class="lost__wave lost__wave--front" viewBox="0 0 1200 160" preserveAspectRatio="none">
        <path d={waveFront}></path>
      </svg>
    </div>

    <div class="container lost__content">
      <p class="eyebrow eyebrow--coral lost__eyebrow">Error 404</p>
      <p class="lost__code display" aria-hidden="true">
        {digits.map((digit, index) => <span class="lost__digit" style={`--i:${index}`}>{digit}</span>)}
      </p>
      <h1 id="lost-title" class="lost__title">Esta ola no llegó a la <em>orilla</em></h1>
      <p class="lead lost__lead">
        La página que buscas no existe o cambió de lugar. Vuelve a la orilla y sigue explorando la colección.
      </p>
      <div class="lost__cta">
        <a class="btn" href="/">Volver al inicio</a>
        <a class="btn btn--ghost" href="/coleccion">
          Ver la colección <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .lost {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: calc(100vh - var(--bar-h));
    min-height: calc(100svh - var(--bar-h));
    padding-block: calc(var(--header-h) + var(--space-xl)) calc(var(--space-2xl) + 8rem);
    overflow: hidden;
  }

  .lost__content {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .lost__code {
    display: flex;
    font-size: clamp(7rem, 3rem + 24vw, 22rem);
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: var(--teal);
  }

  .lost__digit {
    display: inline-block;
    animation: lost-rise 1.3s var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 120ms + 100ms);
  }

  .lost__digit:nth-child(2) {
    font-style: italic;
    color: var(--coral);
    animation-name: lost-rise, lost-bob;
    animation-duration: 1.3s, 5s;
    animation-delay: calc(var(--i) * 120ms + 100ms), 1.6s;
    animation-iteration-count: 1, infinite;
    animation-timing-function: var(--ease-out-expo), ease-in-out;
  }

  .lost__eyebrow {
    animation: rise-in 1s var(--ease-out-expo) both;
  }

  .lost__title {
    max-width: 16ch;
    animation: rise-in 1.1s var(--ease-out-expo) 0.4s both;
  }

  .lost__lead {
    animation: rise-in 1.1s var(--ease-out-expo) 0.55s both;
  }

  .lost__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    animation: rise-in 1.1s var(--ease-out-expo) 0.7s both;
  }

  .lost__waves {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 12rem;
    pointer-events: none;
  }

  .lost__wave {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 200%;
    height: 100%;
    animation: lost-drift 14s linear infinite;
    will-change: transform;
  }

  .lost__wave--back {
    fill: var(--teal-soft);
    opacity: 0.9;
  }

  .lost__wave--front {
    height: 78%;
    fill: var(--teal);
    animation-duration: 9s;
    animation-direction: reverse;
  }

  @keyframes lost-rise {
    from {
      opacity: 0;
      transform: translateY(40%) rotate(4deg);
    }
  }

  @keyframes lost-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-6%) rotate(-3deg);
    }
  }

  @keyframes lost-drift {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lost__digit,
    .lost__eyebrow,
    .lost__title,
    .lost__lead,
    .lost__cta,
    .lost__wave {
      animation: none !important;
    }
  }
</style>
